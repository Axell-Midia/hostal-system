# Copia este archivo a .env y cambia los valores con datos propios.
# .env NO debe subirse al repositorio.

# Base de datos
POSTGRES_DB=hostal_db
POSTGRES_USER=hostal_user
POSTGRES_PASSWORD=cambia_esta_contrasena_segura

# Clave del JWT: genera una aleatoria con, por ejemplo:
#   openssl rand -base64 48
# En Windows PowerShell:
#   $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=genera_una_clave_aleatoria_de_48_bytes
